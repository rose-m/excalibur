# Used by pnpm compose (docker compose --env-file .env.compose).
COMPOSE_APP_PORT=53080
# Optional override for a public proxy; otherwise follows COMPOSE_APP_PORT.
# PUBLIC_URL=http://localhost:53080
# Additional exact browser origins (comma-separated). PUBLIC_URL stays canonical.
# ALLOWED_ORIGINS=http://localhost:53080,https://your-url.ngrok-free.app
# Protect tunnels with authentication/access controls before exposing development mode.

# Postgres host port and initial credentials. Internal connections use postgres:5432.
PGPORT=55432
PGDATABASE=excalibur
PGUSER=excalibur
PGPASSWORD=excalibur

# Local-only opt-out. Never expose development mode publicly.
AUTH_MODE=development
# For PropelAuth, set AUTH_MODE=propelauth and configure the exact public origin.
# PROPELAUTH_AUTH_URL=https://your-project.propelauthtest.com
# PROPELAUTH_API_KEY=server-side-api-key
# PROPELAUTH_REQUEST_VALIDATION_CLIENT_ID=your-request-validation-client-id
# PROPELAUTH_REQUEST_VALIDATION_CLIENT_SECRET=your-request-validation-client-secret
