HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=excalibur
PGUSER=excalibur
PGPASSWORD=excalibur
# Tests reuse the PG connection settings, but use the excalibur_test database.
# Optional override for a separate test server:
# TEST_DATABASE_URL=postgres://excalibur:excalibur@127.0.0.1:55432/excalibur_test

# Explicit local-only opt-out. Production defaults to propelauth if unset.
AUTH_MODE=development
# For authenticated mode, set AUTH_MODE=propelauth and both values below.
# PROPELAUTH_AUTH_URL=https://your-project.propelauthtest.com
# PROPELAUTH_API_KEY=server-side-api-key
# PUBLIC_URL must exactly match the browser origin configured in PropelAuth.
# pnpm dev uses http://127.0.0.1:5173 unless PUBLIC_URL is supplied.

# Optional MCP OAuth: generate a separate pair under MCP > Request Validation.
# Set both to enable authenticated MCP; configure the canvases:access Org Scope.
# PROPELAUTH_REQUEST_VALIDATION_CLIENT_ID=your-request-validation-client-id
# PROPELAUTH_REQUEST_VALIDATION_CLIENT_SECRET=your-request-validation-client-secret
# Authenticated MCP accepts all origins using bearer tokens, not cookies.

# For trusted-LAN testing, use pnpm dev --allow-local instead of changing HOST.
# Development mode has no authentication. Never expose it publicly or commit credentials.
