{
  "name": "excalibur",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compose": "docker compose --env-file .env.compose",
    "dev": "tsx --env-file-if-exists=.env scripts/dev.ts",
    "dev:server": "AUTH_MODE=${AUTH_MODE:-development} PUBLIC_URL=${PUBLIC_URL:-http://localhost:5173} tsx watch src/server/index.ts",
    "dev:web": "pnpm assets && vite --port 5173 --strictPort",
    "assets": "node scripts/copy-editor-assets.mjs",
    "build": "pnpm assets && pnpm build:headless && tsc && vite build",
    "build:headless": "node scripts/build-headless.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tools.json",
    "test": "pnpm build:headless && tsx --tsconfig tsconfig.web.json --test tests/*.test.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/jsdom": "21",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/canvas": "^1.1.0",
    "@propelauth/node": "^2.1.36",
    "@propelauth/react": "^2.1.1",
    "fractional-indexing": "3.2.0",
    "hono": "^4.13.16",
    "image-size": "^2.0.4",
    "jsdom": "26",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
