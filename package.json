{
  "name": "excalibur",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "pnpm assets && vite --host 127.0.0.1 --port 5173 --strictPort",
    "assets": "node scripts/copy-editor-assets.mjs",
    "build": "pnpm assets && tsc && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tools.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@hono/node-server": "^2.1.6",
    "fractional-indexing": "3.2.0",
    "hono": "^4.13.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
